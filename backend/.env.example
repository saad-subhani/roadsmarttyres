# Copy this file to backend/.env and set a strong, unique admin password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
FRONTEND_URL=http://localhost:3000
APP_ENV=development
SESSION_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=roadsmarttyres
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Optional. Without SMTP, PHP mail() is used when available.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=15
MAIL_FROM=
